# Optional local overrides for Docker Compose; also loadable in the IDE run configuration.

DB_URL=jdbc:postgresql://localhost:5432/solicitations
DB_USERNAME=solicitations
DB_PASSWORD=admin

ELASTICSEARCH_URIS=http://localhost:9200

# HS256 key: at least 32 characters
JWT_SECRET=local-development-secret-change-me-0123456789
# Token lifetime (30m, 1h, ...)
JWT_EXPIRATION=1h

# First ADMIN, created on startup when no ADMIN exists
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin12345

VIACEP_URL=https://viacep.com.br/ws

SERVER_PORT=8080
SWAGGER_ENABLED=true
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Host ports published by compose.yaml (change if already in use)
POSTGRES_PORT=5432
ELASTICSEARCH_PORT=9200
